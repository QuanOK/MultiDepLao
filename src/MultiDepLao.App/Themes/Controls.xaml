<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Style dung chung (ban C1). Mau luon qua DynamicResource tu Light.xaml / Dark.xaml. -->

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <BooleanToVisibilityConverter x:Key="B2V"/>

    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    </Style>

    <!-- Nut vien thuoc / tron mau Acc -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource AccFg}"/>
        <Setter Property="Background" Value="{DynamicResource Acc}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nut icon tron (thu gon / mo rong) -->
    <Style x:Key="RoundIconButton" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cont2}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nut vien thuoc o chan thanh ben: dac (Sec) va vien (Line) -->
    <Style x:Key="FooterPillButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource SecFg}"/>
        <Setter Property="Background" Value="{DynamicResource Sec}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="15" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.85"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Acc}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FooterOutlineButton" TargetType="Button" BasedOn="{StaticResource FooterPillButton}">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cont2}"/>
                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Cont}"/></Trigger>
        </Style.Triggers>
    </Style>

    <!-- Thanh tien do mong (the tai khoan, sao chep ban Zalo) -->
    <Style x:Key="ThinBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Cont2}"/>
        <Setter Property="Foreground" Value="{DynamicResource Acc}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"/>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thanh cuon mong -->
    <Style x:Key="NullRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ThinThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource Line}" CornerRadius="3" Margin="1,0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource NullRepeat}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource ThinThumb}"/></Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource NullRepeat}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Container danh sach tai khoan: khong highlight mac dinh (the tu ve nen theo IsSelected / IsMouseOver) -->
    <Style x:Key="AccountItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The tai khoan (che do rong) -->
    <Style x:Key="AccountCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surf}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="8,7"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cont}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Surf}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Acc}"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Opacity="0.18" Color="Black"/>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- O thu gon 44x44 -->
    <Style x:Key="AccountCell" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cont}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Sec}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Chip trang thai -->
    <Style x:Key="ChipBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource OffBg}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Running"><Setter Property="Background" Value="{DynamicResource OkBg}"/></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Starting"><Setter Property="Background" Value="{DynamicResource WarnBg}"/></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Stopping"><Setter Property="Background" Value="{DynamicResource WarnBg}"/></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="Background" Value="{DynamicResource ErrBg}"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- Nhan loai tai khoan (PC / Web) canh chip trang thai -->
    <Style x:Key="KindTag" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource KindPcBg}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsWeb}" Value="True">
                <Setter Property="Background" Value="{DynamicResource KindWebBg}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="KindTagText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource KindPcFg}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsWeb}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource KindWebFg}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- The chon loai tai khoan trong hop thoai Them tai khoan (RadioButton: chon = vien Acc + nen Cont) -->
    <Style x:Key="KindCard" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{DynamicResource Surf}" BorderBrush="{DynamicResource Line}" BorderThickness="2" CornerRadius="12" Padding="14,12">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cont}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Acc}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cont}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Acc}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Off}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Running"><Setter Property="Foreground" Value="{DynamicResource Ok}"/></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Starting"><Setter Property="Foreground" Value="{DynamicResource Warn}"/></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Stopping"><Setter Property="Foreground" Value="{DynamicResource Warn}"/></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource Err}"/></DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Ghi chu duoi ten -->
    <Style x:Key="NoteText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8,0,4,0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasUnread}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Err}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource Err}"/></DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Vong trang thai quanh avatar (thu gon) -->
    <Style x:Key="StateRing" TargetType="Ellipse">
        <Setter Property="Stroke" Value="{DynamicResource Line}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="Fill" Value="Transparent"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Running"><Setter Property="Stroke" Value="{DynamicResource Ok}"/></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Starting"><Setter Property="Stroke" Value="{DynamicResource Warn}"/></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Stopping"><Setter Property="Stroke" Value="{DynamicResource Warn}"/></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="Stroke" Value="{DynamicResource Err}"/></DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Avatar mo khi Ngu / Loi -->
    <Style x:Key="AvatarDim" TargetType="Grid">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Dim}" Value="True"><Setter Property="Opacity" Value="0.55"/></DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- O co (20x20 vien Line bo 6; che do chat: 15 khong vien) -->
    <Style x:Key="FlagBox" TargetType="Border">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="Margin" Value="3,0,0,0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Compact}" Value="True">
                <Setter Property="Width" Value="15"/>
                <Setter Property="Height" Value="15"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin" Value="1,0,0,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="FlagBoxWarn" TargetType="Border" BasedOn="{StaticResource FlagBox}">
        <Setter Property="BorderBrush" Value="{DynamicResource Warn}"/>
    </Style>

    <!-- Banner ghi chu o chan -->
    <Style x:Key="Banner" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- ===== Hop thoai kieu ContentDialog Windows 11 ===== -->
    <!-- Nut hop thoai (phu: vien Line nen Surf) -->
    <Style x:Key="DlgButton" TargetType="Button">
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="Background" Value="{DynamicResource Surf}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cont}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Acc}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Nut chinh: nen Acc, khong vien -->
    <Style x:Key="DlgPrimaryButton" TargetType="Button" BasedOn="{StaticResource DlgButton}">
        <Setter Property="Foreground" Value="{DynamicResource AccFg}"/>
        <Setter Property="Background" Value="{DynamicResource Acc}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Nut nho trong Cai dat -->
    <Style x:Key="DlgSmallButton" TargetType="Button" BasedOn="{StaticResource DlgButton}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="14,0"/>
    </Style>

    <!-- O nhap -->
    <Style TargetType="TextBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Acc}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{DynamicResource Surf}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4"/>
                        <Border x:Name="Under" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Muted}" CornerRadius="0,0,4,4"/>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Under" Property="Height" Value="2"/>
                            <Setter TargetName="Under" Property="Background" Value="{DynamicResource Acc}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Acc}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{DynamicResource Surf}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4"/>
                        <Border x:Name="Under" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Muted}" CornerRadius="0,0,4,4"/>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Under" Property="Height" Value="2"/>
                            <Setter TargetName="Under" Property="Background" Value="{DynamicResource Acc}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox / RadioButton -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="20" Height="20" CornerRadius="4" BorderThickness="1" VerticalAlignment="Center"
                                BorderBrush="{DynamicResource Muted}" Background="Transparent">
                            <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{DynamicResource AccFg}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Acc}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Acc}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Acc}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource Muted}" StrokeThickness="1" Fill="Transparent"/>
                            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource Acc}" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Acc}"/>
                            <Setter TargetName="Ring" Property="StrokeThickness" Value="2"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Acc}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- O mau nhan 22px (Background = mau o; vong Fg 2px khi chon) -->
    <Style x:Key="AccentSwatch" TargetType="RadioButton">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Sel" Width="28" Height="28" Stroke="{DynamicResource Fg}" StrokeThickness="2" Visibility="Collapsed"/>
                        <Ellipse x:Name="Foc" Width="30" Height="30" Stroke="{DynamicResource Muted}" StrokeThickness="1" StrokeDashArray="2 2" Visibility="Collapsed"/>
                        <Ellipse Width="22" Height="22" Fill="{TemplateBinding Background}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Sel" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Foc" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollViewer trong hop thoai dung thanh cuon mong -->
    <Style x:Key="DlgScroll" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="False"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Style="{StaticResource ThinScrollBar}"
                                   Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tien do: Acc tren Cont2 -->
    <Style x:Key="DlgProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource Cont2}"/>
        <Setter Property="Foreground" Value="{DynamicResource Acc}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="TemplateRoot" ClipToBounds="True">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"/>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
                        <Border x:Name="Indet" Background="{TemplateBinding Foreground}" CornerRadius="2" Width="90" HorizontalAlignment="Left"
                                Visibility="Collapsed" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform><TranslateTransform x:Name="Slide"/></Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Indet" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Anim">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" From="-90" To="340" Duration="0:0:1.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="Anim"/></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Menu chuot phai ===== -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="8,6,12,14" Background="{DynamicResource Cont}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="8" Padding="0,6">
                        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.28" Color="Black"/></Border.Effect>
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource Line}"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Hover" Margin="4,0" CornerRadius="4" Background="{DynamicResource Fg}" Opacity="0"/>
                        <Grid Margin="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="Ic" ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Chk" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="2" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.08"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chk" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Ic" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thanh lenh phia tren Zalo: nut thao tac vien (cao 32, bo 16) -->
    <Style x:Key="CmdButton" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="16" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cont}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chip vien (quyen / co) tren thanh lenh -->
    <Style x:Key="OutChip" TargetType="Border">
        <Setter Property="Height" Value="26"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
